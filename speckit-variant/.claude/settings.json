{
  "permissions": {
    "allow": [
      "Bash(pnpm nx:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm test:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(docker compose:*)",
      "Bash(scripts/stack-up.sh)",
      "Bash(scripts/stack-down.sh)",
      "Bash(scripts/stack-reset.sh)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(.specify/scripts/bash/*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  }
}
