{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "jsx": "react-jsx",
    "noEmit": false,
    "incremental": false,
    "types": ["jest", "node"]
  },
  "include": ["jest.config.ts", "src/test-setup.ts", "src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.d.ts"],
  "exclude": ["node_modules"]
}
