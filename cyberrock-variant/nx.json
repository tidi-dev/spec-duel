{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "affected": { "defaultBase": "main" },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/package.json"]
  },
  "targetDefaults": {
    "build": { "dependsOn": ["^build"], "inputs": ["default", "^default"], "cache": true },
    "test": { "inputs": ["default", "^default", "{workspaceRoot}/jest.preset.js"], "cache": true },
    "lint": { "inputs": ["default", "{workspaceRoot}/.eslintrc.json", "{workspaceRoot}/.eslintignore"], "cache": true }
  }
}
