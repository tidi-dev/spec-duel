{
  "name": "contract",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/contract/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/contract",
        "tsConfig": "libs/contract/tsconfig.lib.json",
        "packageJson": "libs/contract/package.json",
        "main": "libs/contract/src/index.ts",
        "assets": []
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": { "lintFilePatterns": ["libs/contract/**/*.ts"], "maxWarnings": 0 }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "jestConfig": "libs/contract/jest.config.ts", "passWithNoTests": false }
    }
  }
}
