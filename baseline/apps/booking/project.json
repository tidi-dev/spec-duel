{
  "name": "booking",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/booking/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/booking",
        "main": "apps/booking/src/main.ts",
        "tsConfig": "apps/booking/tsconfig.app.json",
        "webpackConfig": "apps/booking/webpack.config.js",
        "assets": []
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": { "buildTarget": "booking:build" }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": { "lintFilePatterns": ["apps/booking/**/*.ts"], "maxWarnings": 0 }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "jestConfig": "apps/booking/jest.config.ts", "passWithNoTests": false }
    }
  }
}
